# One authority for whitespace so files never drift styles again.
# Prettier (npm run format) is the enforcement; this covers any editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
