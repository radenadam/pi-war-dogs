		"cheerio": "^1.0.0",
		"pi-mcp-adapter": "2.29.0",
		"playwright-core": "^1.62.1",
		"tsx": "^4.23.12",
		"undici": "^8.10.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@earendil-works/pi-tui": "0.84.4",
		"@types/node": "^20",
		"prettier": "^3.9.6",
		"typebox": "1.3.7",
		"typescript": "5.9.x"
	},
	"scripts": {
		"fetch": "tsx cli/fetch.ts",
